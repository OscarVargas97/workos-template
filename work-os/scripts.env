# Perfil de esta máquina para los scripts de workos/work-os/scripts/.
# Se versiona en este repo privado: NUNCA pongas LOGIN_PASSWORD ni
# DISK_PASSPHRASE acá - dejalas vacías y el script te las pide.
# Vacío = te lo piden interactivamente. Compartido por
# nixos-anywhere-deploy.sh, post-install-setup.sh y migrate-pc.sh - cada
# uno usa lo que necesita, ninguno pisa lo que no usa.
LOGIN_USER=
# Sin esta, cualquier corrida en background (sin terminal interactiva)
# falla apenas arranca: el primer 'read' de la clave SSH no tiene de
# dónde leer y aborta bajo 'set -e' (bug real, encontrado corriendo
# post-install-setup.sh así). Con terminal interactiva no hace falta,
# el script te la pide con Enter para aceptar el default.
SSH_KEY=

# Empresa de esta máquina (post-install-setup.sh, DECISIONS.md #11; su
# company-context es companies/<empresa>/ del repo privado) -
# vacío = te lo pregunta. No hardcodear "la empresa de siempre" acá:
# este .env es el perfil de ESTA máquina puntual - para otra empresa se
# arma otro .env (o se deja vacío y se responde a mano esa corrida).
COMPANY_NAME=
# Email de Bitwarden (solo se muestra en las instrucciones finales de
# post-install-setup.sh; el login lo hacés vos).
RBW_EMAIL=
